{
  "title": {
    "text": "Curvas de Capacidad de Almacenamiento",
    "left": "center",
    "textStyle": {
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#333"
    }
  },
  "tooltip": {
    "trigger": "axis",
    "axisPointer": {
      "type": "cross",
      "crossStyle": {
        "color": "#999"
      }
    },
    "formatter": "function(params) {\n                var result = 'Elevación: ' + params[0].value[1] + ' m<br/>';\n                for (var i = 0; i < params.length; i++) {\n                    if (params[i].seriesName === 'Capacity vs Elevation') {\n                        result += 'Capacidad: ' + params[i].value[0] + ' m³<br/>';\n                    } else if (params[i].seriesName === 'Area vs Elevation') {\n                        result += 'Área: ' + params[i].value[0] + ' ha<br/>';\n                    }\n                }\n                return result;\n            }"
  },
  "legend": {
    "data": [
      "Capacity vs Elevation",
      "Area vs Elevation"
    ],
    "top": "bottom",
    "textStyle": {
      "fontSize": 12
    }
  },
  "grid": {
    "left": "8%",
    "right": "8%",
    "bottom": "15%",
    "top": "15%",
    "containLabel": true
  },
  "xAxis": [
    {
      "type": "value",
      "name": "Capacidad m3",
      "nameLocation": "middle",
      "nameGap": 25,
      "min": 0,
      "max": 3500,
      "nameTextStyle": {
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "axisLine": {
        "lineStyle": {
          "color": "#4A90E2"
        }
      },
      "splitLine": {
        "show": true,
        "lineStyle": {
          "color": "#e0e0e0"
        }
      }
    },
    {
      "type": "value",
      "name": "Area",
      "nameLocation": "middle",
      "nameGap": 25,
      "position": "top",
      "min": 0,
      "max": 0.4,
      "nameTextStyle": {
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#F5A623"
      },
      "axisLine": {
        "lineStyle": {
          "color": "#F5A623"
        }
      },
      "axisLabel": {
        "color": "#F5A623"
      },
      "show": true
    }
  ],
  "yAxis": {
